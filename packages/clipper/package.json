{
  "name": "@book-of-ages/clipper",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "vite build && node -e \"const fs=require('fs'); fs.mkdirSync('dist/src/assets',{recursive:true}); fs.copyFileSync('manifest.json','dist/manifest.json'); fs.copyFileSync('src/assets/icon128.png','dist/src/assets/icon128.png');\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@book-of-ages/shared": "*"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3",
    "vite": "^8.0.3"
  }
}
